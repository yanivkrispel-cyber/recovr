{
  "name": "recoveryos",
  "version": "1.0.0",
  "private": true,
  "description": "RecoveryOS — Sports Injury Rehab Platform (v1)",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --filter clinician dev & pnpm --filter patient dev",
    "build": "pnpm -r build",
    "build:firebase": "pnpm --filter clinician build && pnpm --filter patient build && node scripts/build-firebase-hosting.mjs",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "ingest:exercises": "deno run --allow-read --allow-write --allow-net --allow-env scripts/ingest-exercises.ts --verify",
    "convert:gif-loops": "deno run --allow-read --allow-write --allow-net --allow-env --allow-run scripts/convert-gif-loops.ts",
    "verify:media": "deno run --allow-net --allow-env scripts/verify-media.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.2.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^1.6.0"
  }
}