{
  "name": "recoveryos",
  "version": "1.0.0",
  "private": true,
  "description": "RecoveryOS — Sports Injury Rehab Platform (v1)",
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "pnpm --filter clinician dev & pnpm --filter patient dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "pnpm -r format",
    "ingest:exercises": "deno run --allow-read --allow-write --allow-net --allow-env scripts/ingest-exercises.ts --verify",
    "verify:media": "deno run --allow-net --allow-env scripts/verify-media.ts"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^1.6.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0"
  }
}