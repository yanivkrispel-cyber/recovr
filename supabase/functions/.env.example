# Copy to supabase/functions/.env and fill in. Used by notifications-dispatch.
# Generate a VAPID keypair with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Shared secret required in the x-dispatch-secret header to invoke the dispatcher.
DISPATCH_SECRET=
APP_BASE_URL=http://localhost:5173
# SMTP relay for the weekly digest email. Local dev: the Supabase inbucket
# container (host 127.0.0.1:54325 / in-network supabase_inbucket_<project>:2500).
SMTP_HOST=
SMTP_PORT=2500
SMTP_FROM=RecoveryOS <digest@example.com>
