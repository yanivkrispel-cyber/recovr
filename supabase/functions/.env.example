# Copy to supabase/functions/.env and fill in.
# Used by notifications-dispatch (push + weekly digest) and patient-invite
# (activation email).
# Generate a VAPID keypair with: npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Shared secret required in the x-dispatch-secret header to invoke the dispatcher.
DISPATCH_SECRET=
# Clinician app base (used for deep links in notifications).
APP_BASE_URL=http://localhost:5173
# Patient PWA base — where the /m/invite/<token> activation link points.
# Prod: usually the same host as APP_BASE_URL. Local dev: the patient vite
# server, e.g. http://localhost:5174. Falls back to APP_BASE_URL if unset.
PATIENT_BASE_URL=http://localhost:5174
# Email sending. Prod: set GMAIL_SMTP_USER + GMAIL_SMTP_PASSWORD — the digest +
# invite emails go through Gmail's SMTP relay (smtp.gmail.com:465, see
# _shared/gmail-smtp.ts) and SMTP_HOST/PORT below are ignored. The password is
# a 16-char Gmail "App Password" (myaccount.google.com/apppasswords, requires
# 2FA on the account), not the account's login password. "From" is always
# GMAIL_SMTP_USER — Gmail's relay rejects a From that doesn't match the
# authenticated account.
# Local dev: leave GMAIL_SMTP_USER unset and use the Supabase inbucket
# container instead — SMTP_HOST=host.docker.internal, SMTP_PORT=54325
# (host-mapped), view caught mail at http://127.0.0.1:54324.
GMAIL_SMTP_USER=
GMAIL_SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=2500
SMTP_FROM=RecoveryOS <no-reply@example.com>
