# .env.example — copy to .env.local and fill. Never commit real values.

# --- Supabase (project settings → API) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server/Edge only. NEVER prefixed with VITE_.
SUPABASE_DB_URL=postgresql://postgres:<pw>@db.<project-ref>.supabase.co:5432/postgres
SUPABASE_PROJECT_REF=<project-ref>

# --- App ---
VITE_APP_ENV=local                # local | staging | production
VITE_CLINICIAN_BASE=/app
VITE_PATIENT_BASE=/m
VITE_DEFAULT_LOCALE=he-IL
VITE_DEFAULT_TIMEZONE=Asia/Jerusalem

# --- Web Push (VAPID) — generate with: npx web-push generate-vapid-keys ---
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# --- Email (clinician weekly digest only; no PHI in bodies) ---
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM="RecoveryOS <no-reply@example.com>"

# --- Storage ---
SUPABASE_STORAGE_BUCKET_EXERCISE_MEDIA=exercise-media
SUPABASE_STORAGE_BUCKET_PATIENT_FILES=patient-files

# --- Jobs / ops ---
CRON_SECRET=                      # shared secret for pg_cron → Edge Function calls
SENTRY_DSN=
LOG_LEVEL=info

# --- Dev seed (local & staging only; refused when VITE_APP_ENV=production) ---
SEED_CLINIC_NAME="מרפאת דמו"
SEED_CLINICIAN_EMAIL=clinician@dev.local
SEED_CLINICIAN_PASSWORD=DevPass!2026
SEED_ADMIN_EMAIL=admin@dev.local
SEED_ADMIN_PASSWORD=DevPass!2026
SEED_PATIENT_EMAIL=patient@dev.local
SEED_PATIENT_PASSWORD=DevPass!2026
# The seed must create the patient mix listed in QA_PLAN.md → "Seed data for testing",
# and must be idempotent (re-running changes nothing).
